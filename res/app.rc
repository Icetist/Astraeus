#include <winver.h>
#include "..\\src\\version.h"

101 ICON "app.ico"
1 24 "app.manifest" // application manifest: runs as the user, per-monitor dpi

201 RCDATA "fonts\\Outfit-200.ttf"
202 RCDATA "fonts\\Outfit-300.ttf"
203 RCDATA "fonts\\Outfit-400.ttf"
204 RCDATA "fonts\\Outfit-500.ttf"
205 RCDATA "fonts\\Outfit-600.ttf"
206 RCDATA "fonts\\SymbolsOutline.ttf"
207 RCDATA "fonts\\SymbolsFilled.ttf"

VS_VERSION_INFO VERSIONINFO
FILEVERSION APP_VER_MAJOR,APP_VER_MINOR,APP_VER_PATCH,0
PRODUCTVERSION APP_VER_MAJOR,APP_VER_MINOR,APP_VER_PATCH,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Icetist"
            VALUE "FileDescription", "Astraeus bezel dashboard"
            VALUE "InternalName", "Astraeus"
            VALUE "OriginalFilename", "Astraeus.exe"
            VALUE "LegalCopyright", "Copyright (c) 2026 Icetist"
            VALUE "ProductName", "Astraeus"
            VALUE "Comments", "A dashboard that drops from the edge of the screen. https://github.com/Icetist/Astraeus"
            VALUE "FileVersion", APP_VER_STR
            VALUE "ProductVersion", APP_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
